{
  "name": "dsh-plugin-updater",
  "version": "0.1.0",
  "description": "DSH Web GUI plugin manager: splits Settings > Plugins into 内置插件列表 (built-in) and 第三方插件列表 (manually installed) tabs with per-plugin origin/version metadata.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "plugin-manager",
    "updater",
    "inventory"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaigyoujiCTakuhei/dsh-selfuse-plugins.git",
    "directory": "packages/dsh-plugin-updater"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
